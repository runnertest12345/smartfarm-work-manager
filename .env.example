# Browser-visible Firebase web configuration, NOT service-account credentials.
# Copy to .env.local with `pnpm run setup`, then copy ALL fields from the SAME
# Firebase project's Web app settings. Never put a private key or token here.
# Reusing an existing project + workspace SHARES its live data; it does not copy it.
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=replace-with-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=replace-with-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=replace-with-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-with-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=replace-with-web-app-id
# Choose explicitly. A fresh workspace also needs initial admin provisioning.
NEXT_PUBLIC_FIREBASE_WORKSPACE_ID=replace-with-workspace-id
NEXT_PUBLIC_SITE_URL=https://replace-with-site.example.invalid
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
# All NEXT_PUBLIC values are frozen into browser files at BUILD time.
# Never deploy .env files. Changing hosting env alone cannot update out/.
