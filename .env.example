# Firebase 웹 앱의 공개 설정값입니다. 비밀 키가 아니며 실제 접근 권한은
# Firebase Authentication과 firestore.rules가 통제합니다.
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=smartfarm-work-manager.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=smartfarm-work-manager
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=smartfarm-work-manager.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-with-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=replace-with-web-app-id
NEXT_PUBLIC_FIREBASE_WORKSPACE_ID=default
NEXT_PUBLIC_SITE_URL=https://34-64-62-115.sslip.io
# 로컬 Firebase Emulator Suite를 사용할 때만 true로 변경합니다.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
