# Local PostgreSQL connection
DATABASE_URL=postgresql://farmlog:change-me@127.0.0.1:5432/farmlog
PGSSLMODE=disable
DB_POOL_MAX=5
SITE_URL=http://localhost:3000

# Cloud Run + Cloud SQL uses these instead of DATABASE_URL
# INSTANCE_CONNECTION_NAME=project-id:asia-northeast3:farmlog-db
# PGUSER=farmlog_app
# PGPASSWORD=store-this-in-secret-manager
# PGDATABASE=farmlog
# IAP_AUDIENCE=/projects/123456789/locations/asia-northeast3/services/farmlog

# Optional: only allow one Google Workspace email domain through IAP
# ALLOWED_EMAIL_DOMAIN=example.com

# Keep false in production. Set true only for local demonstrations.
ENABLE_SAMPLE_DATA=false
