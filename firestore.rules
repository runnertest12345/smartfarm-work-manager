rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && (request.auth.token.get('email_verified', false) == true
          || (request.auth.token.get('email', '').matches('^u([0-9a-f]{2}){2,30}@staff[.]smartfarm-work-manager[.]invalid$')
            && request.auth.token.firebase.sign_in_provider == 'password'));
    }

    function activeMember(workspaceId) {
      return signedIn()
        && get(/databases/$(database)/documents/appMembers/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/appMembers/$(request.auth.uid)).data.get('workspaceId', workspaceId) == workspaceId;
    }

    function personalMember(workspaceId, uid) {
      let member = get(/databases/$(database)/documents/appMembers/$(uid)).data;
      return member.active == true && member.get('workspaceId', '') == workspaceId
        && member.get('email', '') != '' && member.email != 'team-access@smartfarm-work-manager.firebaseapp.com';
    }

    function organizationAdmin(workspaceId) {
      return signedIn() && personalMember(workspaceId, request.auth.uid)
        && get(/databases/$(database)/documents/appMembers/$(request.auth.uid)).data.get('admin', false) == true;
    }

    function sameTaskContext(a, b) {
      return a.get('scope', '') == b.get('scope', '') && a.get('projectId', '') == b.get('projectId', '')
        && (a.get('scope', '') != 'internal' || (a.get('departmentId', '') != '' && a.departmentId == b.get('departmentId', '')));
    }

    function validNewAssignment(workspaceId, after) {
      let assignee = get(/databases/$(database)/documents/appMembers/$(after.assigneeUid)).data;
      let actor = get(/databases/$(database)/documents/appMembers/$(request.auth.uid)).data;
      let department = get(/databases/$(database)/documents/workspaces/$(workspaceId)/departments/$(after.departmentId)).data;
      return personalMember(workspaceId, request.auth.uid) && personalMember(workspaceId, after.assigneeUid)
        && after.assignedByUid == request.auth.uid && after.owner == assignee.displayName
        && after.departmentId == assignee.departmentId && department.id == after.departmentId
        && after.assignedAt is int && after.assignedAt == after.createdAt
        && after.assignedAt <= request.time.toMillis() + 300000 && after.assignedAt >= request.time.toMillis() - 300000
        && after.headAssigned == (department.headUid == request.auth.uid && actor.departmentId == after.departmentId && after.assigneeUid != request.auth.uid);
    }

    function validWorkAssignment(workspaceId, creating) {
      let after = request.resource.data;
      let before = creating ? {} : resource.data;
      let assigned = after.get('assigneeUid', '') != '';
      return after.get('scope', '') in ['', 'internal']
        && (after.get('scope', '') != 'internal' || (after.get('projectId', '') == '' && after.farmRecordId == '' && after.farmId == ''
          && after.workType in ['communication', 'installation', 'service', 'note']))
        && (creating
          ? (assigned ? validNewAssignment(workspaceId, after)
            : after.get('scope', '') != 'internal' && !after.keys().hasAny(['assignedByUid', 'departmentId', 'headAssigned', 'assignedAt']))
          : !after.diff(before).affectedKeys().hasAny(['scope', 'assigneeUid', 'assignedByUid', 'departmentId', 'headAssigned', 'assignedAt'])
            && (!assigned || after.owner == before.owner));
    }

    function knownCollection(name) {
      return name in [
        'projects',
        'projectDocuments',
        'projectUpdates',
        'farms',
        'farmRecords',
        'subscriptionEvents',
        'inboxItems',
        'workItems',
        'blockerEpisodes',
        'visits',
        'checklistItems',
        'historyEntries',
        'farmCodeReservations',
        'farmRecordReservations'
      ];
    }

    function validDocument(documentId) {
      return request.resource.data.keys().hasAll([
          'id', 'createdAt', 'updatedAt', 'createdByUid', 'updatedByUid'
        ])
        && request.resource.data.size() <= 64
        && request.resource.data.id == documentId
        && request.resource.data.id is string
        && request.resource.data.id.size() > 0
        && request.resource.data.id.size() <= 160
        && request.resource.data.createdAt is int
        && request.resource.data.updatedAt is int
        && request.resource.data.createdAt > 0
        && request.resource.data.updatedAt >= request.resource.data.createdAt
        && request.resource.data.createdByUid is string
        && request.resource.data.createdByUid.size() > 0
        && request.resource.data.updatedByUid == request.auth.uid;
    }

    function validCreate(documentId) {
      return validDocument(documentId)
        && request.resource.data.createdByUid == request.auth.uid;
    }

    function validUpdate(documentId) {
      return validDocument(documentId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.updatedAt >= resource.data.updatedAt;
    }

    function validRelations(workspaceId, name, creating) {
      return name == 'projects'
        || name == 'farms'
        || name == 'inboxItems'
        || name == 'farmCodeReservations'
        || name == 'farmRecordReservations'
        || (name == 'projectDocuments'
          && request.resource.data.projectId is string
          && (!creating || getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/projects/$(request.resource.data.projectId)).data.get('deletedAt', 0) == 0)
          && getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/projects/$(request.resource.data.projectId)).data.id == request.resource.data.projectId)
        || (name == 'projectUpdates'
          && request.resource.data.projectId is string
          && getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/projects/$(request.resource.data.projectId)).data.id == request.resource.data.projectId)
        || (name == 'farmRecords'
          && request.resource.data.farmId is string
          && request.resource.data.projectId is string
          && (!creating || getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/projects/$(request.resource.data.projectId)).data.get('deletedAt', 0) == 0)
          && getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/farms/$(request.resource.data.farmId)).data.id == request.resource.data.farmId
          && getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/projects/$(request.resource.data.projectId)).data.id == request.resource.data.projectId)
        || (name == 'subscriptionEvents'
          && request.resource.data.farmRecordId is string
          && getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/farmRecords/$(request.resource.data.farmRecordId)).data.id == request.resource.data.farmRecordId)
        || (name == 'workItems'
          && request.resource.data.farmRecordId is string
          && ((request.resource.data.farmRecordId != ''
            && getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/farmRecords/$(request.resource.data.farmRecordId)).data.id == request.resource.data.farmRecordId)
          || (request.resource.data.get('scope', '') == 'internal'
            && request.resource.data.farmRecordId == '' && request.resource.data.farmId == ''
            && request.resource.data.get('projectId', '') == ''
            && request.resource.data.workType in ['communication', 'installation', 'service', 'note'])
          || (request.resource.data.farmRecordId == ''
            && request.resource.data.farmId == ''
            && request.resource.data.projectId is string
            && request.resource.data.projectId != ''
            && (!creating || getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/projects/$(request.resource.data.projectId)).data.get('deletedAt', 0) == 0)
            && request.resource.data.workType in ['communication', 'installation', 'service', 'note']
            && getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/projects/$(request.resource.data.projectId)).data.id == request.resource.data.projectId)))
        || (name in ['blockerEpisodes', 'visits', 'checklistItems', 'historyEntries']
          && request.resource.data.workItemId is string
          && getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/workItems/$(request.resource.data.workItemId)).data.id == request.resource.data.workItemId);
    }

    // Old clients must not erase a deletion marker by saving an entire project.
    function linkedFarmImage(workspaceId, farmId, imageId) {
      let image = getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/imageAttachments/$(imageId)).data;
      return imageId is string && imageId.matches('^[a-zA-Z0-9-]{16,80}$')
        && image.id == imageId && image.parentCollection == 'farms' && image.parentId == farmId;
    }

    function validFarmImages(workspaceId, farmId, creating) {
      let after = request.resource.data;
      let before = creating ? {} : resource.data;
      let ids = after.get('locationImageIds', []);
      return ids is list && ids.size() <= 3 && ids.toSet().size() == ids.size()
        && (!before.keys().hasAny(['locationImageIds']) || after.keys().hasAny(['locationImageIds']))
        && (ids == before.get('locationImageIds', []) || (
          (ids.size() < 1 || linkedFarmImage(workspaceId, farmId, ids[0]))
          && (ids.size() < 2 || linkedFarmImage(workspaceId, farmId, ids[1]))
          && (ids.size() < 3 || linkedFarmImage(workspaceId, farmId, ids[2]))));
    }

    function validProjectLifecycle(workspaceId, documentId, creating) {
      let before = creating ? {} : resource.data;
      let after = request.resource.data;
      let previous = before.get('deletedAt', 0);
      let next = after.get('deletedAt', 0);
      return next is int && next >= 0
        && (creating ? next == 0 : (
          (next == previous
            && after.get('deletedByUid', '') == before.get('deletedByUid', '')
            && after.get('lifecycleUpdateId', '') == before.get('lifecycleUpdateId', ''))
          || projectLifecycleChange(workspaceId, documentId, before, after)));
    }

    function projectLifecycleChange(workspaceId, documentId, before, after) {
      let updateId = after.get('lifecycleUpdateId', '');
      let path = /databases/$(database)/documents/workspaces/$(workspaceId)/projectUpdates/$(updateId);
      let audit = getAfter(path).data;
      let deleting = after.get('deletedAt', 0) > 0;
      return updateId is string && updateId != '' && !exists(path)
        && after.diff(before).affectedKeys().hasOnly(['deletedAt', 'deletedByUid', 'lifecycleUpdateId', 'updatedAt', 'updatedByUid'])
        && ((deleting && before.get('deletedAt', 0) == 0 && after.deletedAt == after.updatedAt && after.deletedByUid == request.auth.uid)
          || (!deleting && before.get('deletedAt', 0) > 0 && after.deletedByUid == ''))
        && audit.id == updateId && audit.projectId == documentId
        && audit.kind == 'system' && audit.channel == 'system'
        && audit.projectLifecycleAction == (deleting ? 'delete' : 'restore')
        && audit.createdAt == after.updatedAt && audit.createdByUid == request.auth.uid;
    }

    function openTask(data) {
      return data.get('status', 'open') == 'completed' ? 0 : 1;
    }

    function childCounterChange(workspaceId, documentId, before, after) {
      let childId = after.get('lastChildMutationId', '');
      let childPath = /databases/$(database)/documents/workspaces/$(workspaceId)/workItems/$(childId);
      let existed = exists(childPath);
      let oldChild = existed ? get(childPath).data : {'status': 'completed'};
      let child = getAfter(childPath).data;
      let oldIds = before.get('childWorkItemIds', []);
      let newIds = after.get('childWorkItemIds', []);
      return childId != '' && childId != documentId
        && child.get('parentWorkItemId', '') == documentId
        && sameTaskContext(child, after)
        && after.get('openChildCount', 0) == before.get('openChildCount', 0) + openTask(child) - openTask(oldChild)
        && (existed
          ? oldChild.get('parentWorkItemId', '') == documentId && newIds == oldIds && childId in newIds
          : !(childId in oldIds) && childId in newIds && newIds.hasAll(oldIds) && newIds.size() == oldIds.size() + 1);
    }

    function linkedParent(workspaceId, documentId, before, after, creating) {
      let parentId = after.parentWorkItemId;
      let path = /databases/$(database)/documents/workspaces/$(workspaceId)/workItems/$(parentId);
      let parent = get(path).data;
      let nextParent = getAfter(path).data;
      let delta = openTask(after) - (creating ? 0 : openTask(before));
      return parentId != documentId
        && parent.id == parentId
        && parent.get('farmRecordId', '') == '' && after.farmRecordId == ''
        && after.workType in ['communication', 'installation', 'service', 'note']
        && parent.workType in ['communication', 'installation', 'service', 'note']
        && sameTaskContext(parent, after)
        && documentId in nextParent.get('childWorkItemIds', [])
        && (openTask(after) == 0 || nextParent.get('status', 'open') != 'completed')
        && (!creating || parent.get('status', 'open') != 'completed')
        && ((delta == 0 && !creating)
          || (nextParent.get('lastChildMutationId', '') == documentId
            && nextParent.get('openChildCount', 0) == parent.get('openChildCount', 0) + delta));
    }

    function validWorkTree(workspaceId, documentId, creating) {
      let after = request.resource.data;
      let before = creating ? {} : resource.data;
      let ids = after.get('childWorkItemIds', []);
      let count = after.get('openChildCount', 0);
      let parentId = after.get('parentWorkItemId', '');
      return parentId is string && ids is list && count is int
        && ids.size() <= 500 && ids.toSet().size() == ids.size()
        && !(documentId in ids) && count >= 0 && count <= ids.size()
        && (openTask(after) != 0 || count == 0)
        && (!creating || (ids.size() == 0 && count == 0))
        && (creating || parentId == before.get('parentWorkItemId', ''))
        && (creating || (parentId == '' && ids.size() == 0)
          || (after.get('projectId', '') == before.get('projectId', '') && after.farmRecordId == before.farmRecordId))
        && (parentId == '' || linkedParent(workspaceId, documentId, before, after, creating))
        && (creating || (ids == before.get('childWorkItemIds', []) && count == before.get('openChildCount', 0))
          || childCounterChange(workspaceId, documentId, before, after));
    }

    match /appMembers/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId
        || organizationAdmin(resource.data.get('workspaceId', ''))
        || resource.data.active == true && personalMember(resource.data.get('workspaceId', ''), request.auth.uid));
      allow list: if signedIn() && request.query.limit != null && request.query.limit <= 5000
        && (organizationAdmin(resource.data.get('workspaceId', ''))
          || personalMember(resource.data.get('workspaceId', ''), request.auth.uid) && resource.data.active == true);
      // Accounts and memberships are created by the authenticated, restricted server only.
      allow create: if false;
      allow update: if organizationAdmin(resource.data.get('workspaceId', ''))
        && resource.data.email != 'team-access@smartfarm-work-manager.firebaseapp.com'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'departmentId', 'jobTitle', 'updatedAt'])
        && request.resource.data.get('jobTitle', '직원') in ['팀장', '직원']
        && request.resource.data.active is bool && request.resource.data.departmentId is string
        && request.resource.data.updatedAt is int && request.resource.data.updatedAt > resource.data.updatedAt
        && (request.auth.uid != userId || request.resource.data.active == true)
        && (!request.resource.data.active || getAfter(/databases/$(database)/documents/workspaces/$(resource.data.workspaceId)/departments/$(request.resource.data.departmentId)).data.id == request.resource.data.departmentId)
        && (resource.data.departmentId == '' || (request.resource.data.active && request.resource.data.departmentId == resource.data.departmentId)
          || getAfter(/databases/$(database)/documents/workspaces/$(resource.data.workspaceId)/departments/$(resource.data.departmentId)).data.headUid != userId);
      // An acknowledgement for the first-login UI, not proof of a password change.
      allow update: if signedIn() && request.auth.uid == userId && resource.data.active == true
        && resource.data.get('passwordChangeRequired', false) == true
        && request.resource.data.passwordChangeRequired == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['passwordChangeRequired', 'updatedAt'])
        && request.resource.data.updatedAt is int && request.resource.data.updatedAt > resource.data.updatedAt;
      allow delete: if false;
    }

    match /workspaces/{workspaceId}/departments/{departmentId} {
      function validDepartment(creating) {
        let after = request.resource.data;
        return after.keys().hasOnly(['id', 'name', 'headUid', 'createdAt', 'updatedAt'])
          && after.id == departmentId && after.name is string && after.name.size() > 0 && after.name.size() <= 80
          && after.headUid is string && after.createdAt is int && after.updatedAt is int && after.updatedAt >= after.createdAt
          && (creating || after.createdAt == resource.data.createdAt && after.updatedAt > resource.data.updatedAt)
          && (after.headUid == '' || (personalMember(workspaceId, after.headUid)
            && getAfter(/databases/$(database)/documents/appMembers/$(after.headUid)).data.departmentId == departmentId));
      }
      allow get: if signedIn() && personalMember(workspaceId, request.auth.uid);
      allow list: if signedIn() && personalMember(workspaceId, request.auth.uid) && request.query.limit != null && request.query.limit <= 5000;
      allow create: if organizationAdmin(workspaceId) && validDepartment(true);
      allow update: if organizationAdmin(workspaceId) && validDepartment(false);
      allow delete: if false;
    }

    match /workspaces/{workspaceId}/{collectionName}/{documentId} {
      allow get: if activeMember(workspaceId) && knownCollection(collectionName);
      allow list: if activeMember(workspaceId)
        && knownCollection(collectionName)
        && request.query.limit != null
        && request.query.limit <= 5000;

      allow create: if activeMember(workspaceId)
        && knownCollection(collectionName)
        && validCreate(documentId)
        && (collectionName != 'farms' || validFarmImages(workspaceId, documentId, true))
        && (collectionName != 'projects' || validProjectLifecycle(workspaceId, documentId, true))
        && (collectionName != 'workItems' || validWorkTree(workspaceId, documentId, true))
        && (collectionName != 'workItems' || validWorkAssignment(workspaceId, true))
        && validRelations(workspaceId, collectionName, true);

      allow update: if activeMember(workspaceId)
        && knownCollection(collectionName)
        && !(collectionName in ['subscriptionEvents', 'historyEntries'])
        && validUpdate(documentId)
        && (collectionName != 'farms' || validFarmImages(workspaceId, documentId, false))
        && (collectionName != 'projects' || validProjectLifecycle(workspaceId, documentId, false))
        && (collectionName != 'workItems' || validWorkTree(workspaceId, documentId, false))
        && (collectionName != 'workItems' || validWorkAssignment(workspaceId, false))
        && validRelations(workspaceId, collectionName, false);

      allow delete: if false;
    }

    // Images are immutable, lazy-loaded, and deliberately not in knownCollection().
    match /workspaces/{workspaceId}/imageAttachments/{imageId} {
      function validImage() {
        let image = request.resource.data;
        let parent = getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/$(image.parentCollection)/$(image.parentId));
        let ids = image.parentCollection == 'farms' ? parent.data.get('locationImageIds', []) : parent.data.get('imageIds', []);
        return image.keys().hasOnly(['id', 'name', 'dataUrl', 'mimeType', 'size', 'width', 'height', 'parentCollection', 'parentId', 'createdAt', 'createdByUid'])
          && image.id == imageId && imageId.matches('^[a-zA-Z0-9-]{16,80}$')
          && image.name is string && image.name.size() > 0 && image.name.size() <= 160
          && image.mimeType in ['image/png', 'image/jpeg', 'image/webp']
          && image.dataUrl is string && image.dataUrl.size() <= 524400
          && image.dataUrl.matches('^data:image/(png|jpeg|webp);base64,[A-Za-z0-9+/]+=*$')
          && image.size is int && image.size > 0 && image.size <= 393216
          && image.width is int && image.width > 0 && image.width <= 12000
          && image.height is int && image.height > 0 && image.height <= 12000
          && image.parentCollection in ['inboxItems', 'historyEntries', 'farms']
          && image.parentId is string && image.parentId.size() > 0 && image.parentId.size() <= 160
          && ids is list && ids.size() <= 3
          && imageId in ids
          && image.createdByUid == request.auth.uid && image.createdAt is int && image.createdAt > 0;
      }
      allow get: if activeMember(workspaceId);
      allow create: if activeMember(workspaceId) && validImage();
      allow list, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
