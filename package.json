{
  "name": "workflow-task-manager",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "env:check": "node scripts/check-environment.mjs",
    "env:check:production": "node scripts/check-environment.mjs --production",
    "dev": "node scripts/check-environment.mjs && next dev",
    "build": "node scripts/check-environment.mjs --build && next build --webpack",
    "build:release": "node scripts/build-release.mjs",
    "test:release": "node scripts/test-release.mjs",
    "preview": "firebase emulators:start --only hosting --project demo-farmlog",
    "firebase:emulators": "firebase emulators:start --project demo-farmlog",
    "firebase:deploy": "node scripts/firebase-deploy-guard.mjs",
    "lint": "oxlint app lib",
    "lint:all": "oxlint",
    "format": "oxfmt"
  },
  "dependencies": {
    "next": "16.3.4",
    "firebase": "12.18.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react-day-picker": "9.8.1",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "firebase-tools": "15.29.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
